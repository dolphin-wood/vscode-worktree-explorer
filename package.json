{
  "name": "vscode-worktree-explorer",
  "displayName": "Worktree Explorer",
  "description": "Browse and search git worktrees in the current window, and jump to the worktree of the active agent session.",
  "version": "0.1.0",
  "publisher": "dolphin-wood",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dolphin-wood/vscode-worktree-explorer.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeExplorer",
          "title": "Worktrees",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktreeExplorer": [
        {
          "id": "worktreeExplorer.list",
          "name": "Worktrees"
        },
        {
          "id": "worktreeExplorer.files",
          "name": "Opened"
        }
      ]
    },
    "commands": [
      {
        "command": "worktreeExplorer.refresh",
        "title": "Refresh",
        "category": "Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeExplorer.quickOpen",
        "title": "Search Files...",
        "category": "Worktrees",
        "icon": "$(search)"
      },
      {
        "command": "worktreeExplorer.quickOpenInWorktree",
        "title": "Search Files in This Worktree...",
        "category": "Worktrees",
        "icon": "$(search)"
      },
      {
        "command": "worktreeExplorer.revealSessionWorktree",
        "title": "Open Worktree of Current Claude Session",
        "category": "Worktrees",
        "icon": "$(root-folder)"
      },
      {
        "command": "worktreeExplorer.openWorktree",
        "title": "Open Worktree",
        "category": "Worktrees",
        "icon": "$(add)"
      },
      {
        "command": "worktreeExplorer.closeWorktree",
        "title": "Close Worktree",
        "category": "Worktrees",
        "icon": "$(close)"
      },
      {
        "command": "worktreeExplorer.closeAllWorktrees",
        "title": "Close All Opened Worktrees",
        "category": "Worktrees",
        "icon": "$(clear-all)"
      },
      {
        "command": "worktreeExplorer.openToSide",
        "title": "Open to the Side",
        "category": "Worktrees",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "worktreeExplorer.newFile",
        "title": "New File...",
        "category": "Worktrees",
        "icon": "$(new-file)"
      },
      {
        "command": "worktreeExplorer.newFolder",
        "title": "New Folder...",
        "category": "Worktrees",
        "icon": "$(new-folder)"
      },
      {
        "command": "worktreeExplorer.rename",
        "title": "Rename...",
        "category": "Worktrees"
      },
      {
        "command": "worktreeExplorer.delete",
        "title": "Delete",
        "category": "Worktrees"
      },
      {
        "command": "worktreeExplorer.openInNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Worktrees"
      },
      {
        "command": "worktreeExplorer.copyPath",
        "title": "Copy Path",
        "category": "Worktrees"
      },
      {
        "command": "worktreeExplorer.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Worktrees"
      },
      {
        "command": "worktreeExplorer.revealInFinder",
        "title": "Reveal in Finder",
        "category": "Worktrees"
      },
      {
        "command": "worktreeExplorer.openTerminalHere",
        "title": "Open Terminal Here",
        "category": "Worktrees"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeExplorer.revealSessionWorktree",
          "when": "view == worktreeExplorer.list",
          "group": "navigation@1"
        },
        {
          "command": "worktreeExplorer.refresh",
          "when": "view == worktreeExplorer.list",
          "group": "navigation@2"
        },
        {
          "command": "worktreeExplorer.quickOpen",
          "when": "view == worktreeExplorer.files",
          "group": "navigation@1"
        },
        {
          "command": "worktreeExplorer.closeAllWorktrees",
          "when": "view == worktreeExplorer.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeExplorer.openWorktree",
          "when": "view == worktreeExplorer.list && viewItem == wtxListItem",
          "group": "inline@1"
        },
        {
          "command": "worktreeExplorer.quickOpenInWorktree",
          "when": "viewItem == wtxListItem || viewItem == wtxOpenedRoot",
          "group": "inline@2"
        },
        {
          "command": "worktreeExplorer.newFile",
          "when": "viewItem == wtxOpenedRoot",
          "group": "inline@3"
        },
        {
          "command": "worktreeExplorer.closeWorktree",
          "when": "viewItem == wtxOpenedRoot",
          "group": "inline@4"
        },
        {
          "command": "worktreeExplorer.openToSide",
          "when": "viewItem == wtxFile",
          "group": "navigation@1"
        },
        {
          "command": "worktreeExplorer.newFile",
          "when": "viewItem == wtxOpenedRoot || viewItem == wtxDir",
          "group": "1_new@1"
        },
        {
          "command": "worktreeExplorer.newFolder",
          "when": "viewItem == wtxOpenedRoot || viewItem == wtxDir",
          "group": "1_new@2"
        },
        {
          "command": "worktreeExplorer.revealInFinder",
          "when": "view == worktreeExplorer.list || view == worktreeExplorer.files",
          "group": "2_workspace@1"
        },
        {
          "command": "worktreeExplorer.openTerminalHere",
          "when": "view == worktreeExplorer.list || view == worktreeExplorer.files",
          "group": "2_workspace@2"
        },
        {
          "command": "worktreeExplorer.openInNewWindow",
          "when": "viewItem == wtxListItem || viewItem == wtxOpenedRoot",
          "group": "2_workspace@3"
        },
        {
          "command": "worktreeExplorer.copyPath",
          "when": "view == worktreeExplorer.list || view == worktreeExplorer.files",
          "group": "5_copy@1"
        },
        {
          "command": "worktreeExplorer.copyRelativePath",
          "when": "view == worktreeExplorer.list || view == worktreeExplorer.files",
          "group": "5_copy@2"
        },
        {
          "command": "worktreeExplorer.rename",
          "when": "viewItem == wtxDir || viewItem == wtxFile",
          "group": "7_modification@1"
        },
        {
          "command": "worktreeExplorer.delete",
          "when": "viewItem == wtxDir || viewItem == wtxFile",
          "group": "7_modification@2"
        }
      ],
      "editor/title": [
        {
          "command": "worktreeExplorer.revealSessionWorktree",
          "when": "config.worktreeExplorer.showEditorTitleButton && (worktreeExplorer.activeTabIsClaude || activeWebviewPanelId == claudeVSCodePanel)",
          "group": "navigation@-1"
        }
      ],
      "commandPalette": [
        {
          "command": "worktreeExplorer.quickOpenInWorktree",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.copyPath",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.copyRelativePath",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.revealInFinder",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.openInNewWindow",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.openTerminalHere",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.openWorktree",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.closeWorktree",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.openToSide",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.newFile",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.newFolder",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.rename",
          "when": "false"
        },
        {
          "command": "worktreeExplorer.delete",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "worktreeExplorer.quickOpen",
        "key": "cmd+alt+p",
        "mac": "cmd+alt+p",
        "win": "ctrl+alt+p",
        "linux": "ctrl+alt+p"
      }
    ],
    "configuration": {
      "title": "Worktree Explorer",
      "properties": {
        "worktreeExplorer.showEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the \"Open Worktree of Current Claude Session\" button in the editor title bar. It only appears while the active tab is a Claude Code session."
        },
        "worktreeExplorer.includeMainCheckout": {
          "type": "boolean",
          "default": false,
          "description": "Also list the main checkout (not a linked worktree). Off by default since it is usually already in the Explorer."
        },
        "worktreeExplorer.extraWorktreeRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional git repository paths to discover worktrees from, for repos outside the workspace folders."
        },
        "worktreeExplorer.hideIgnoredFiles": {
          "type": "boolean",
          "default": true,
          "description": "Hide files and directories ignored by .gitignore in the file tree, matching what search already does. Read once per worktree via `git ls-files --ignored`."
        },
        "worktreeExplorer.excludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git"
          ],
          "description": "Directory names always hidden in the file tree, on top of whatever .gitignore already excludes. Most build and dependency directories are covered by hideIgnoredFiles, so this is only for things git does not ignore."
        },
        "worktreeExplorer.quickOpenMaxFiles": {
          "type": "number",
          "default": 20000,
          "description": "Maximum number of files indexed per worktree for search."
        },
        "worktreeExplorer.autoRevealOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "On window startup, automatically open the worktree of the current Claude session."
        },
        "worktreeExplorer.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude Code home directory. Empty means ~/.claude (or $CLAUDE_CONFIG_DIR)."
        },
        "worktreeExplorer.useFileIcons": {
          "type": "boolean",
          "default": true,
          "description": "Use the file icon theme for the file tree. This also applies git decorations; turn it off if worktrees ignored by the parent repo show up greyed out."
        },
        "worktreeExplorer.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the active editor's file in the tree, the way the Explorer's autoReveal does. Only acts while the view is visible."
        },
        "worktreeExplorer.repoScanDepth": {
          "type": "number",
          "default": 2,
          "description": "How many levels below each workspace folder to scan when discovering git repositories."
        },
        "worktreeExplorer.searchScopeFallback": {
          "type": "string",
          "enum": [
            "all",
            "opened"
          ],
          "default": "all",
          "description": "Default search scope when no worktree is opened."
        },
        "worktreeExplorer.showGitStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show git status colors and badges on the file tree, the way the Explorer does. Status is read only for opened worktrees."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "worktreeExplorer.files",
        "contents": "No worktree opened yet.\n\nPick one from the Worktrees list above to browse its files here.\n\n[Open Worktree of Current Claude Session](command:worktreeExplorer.revealSessionWorktree)"
      }
    ]
  }
}